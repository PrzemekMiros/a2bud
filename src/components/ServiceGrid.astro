---
import { services } from '../data/services';
import ServicePhoto from './ServicePhoto.astro';
---
<div class="service-grid">{services.map((service, i) => <article class="service-card"><a href={`/uslugi/${service.slug}/`} aria-label={service.name} tabindex="-1"><ServicePhoto image={service.image} /></a><div class="service-body"><span class="card-number">{String(i + 1).padStart(2, '0')} /</span><h3><a href={`/uslugi/${service.slug}/`}>{service.name}</a></h3><p>{service.description}</p><a class="text-link" href={`/uslugi/${service.slug}/`}>Dowiedz się więcej <span>↗</span></a></div></article>)}</div>
