---
interface Props {
  index: number;
}

const { index } = Astro.props;
// Wspólna siatka i grubość linii zapewniają spójność wszystkich symboli.
const paths = [
  // Warstwy — kompleksowy zakres prac.
  ['m12 3 9 5-9 5-9-5 9-5Z', 'm3 12 9 5 9-5', 'm3 16 9 5 9-5'],
  // Osoba — indywidualne podejście.
  ['M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z', 'M4 21v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2'],
  // Dom i biuro — klienci indywidualni i biznesowi.
  ['m2 11 6-5 6 5', 'M4 10v11h8V10', 'M7 21v-5h2v5', 'M12 7V3h9v18h-9', 'M16 7h1', 'M16 11h1', 'M16 15h1'],
  // Ekierka i ołówek — projekt oraz wykonanie.
  ['M3 3v18h18L3 3Z', 'M7 12v5h5l-5-5Z', 'm13 6 3-3 5 5-3 3-5-5Z', 'm13 6-2 5 5-2'],
  // Suwaki — rozwiązania dopasowane do inwestycji.
  ['M4 3v4m0 4v10', 'M12 3v10m0 4v4', 'M20 3v4m0 4v10', 'M2 7h4v4H2V7Z', 'M10 13h4v4h-4v-4Z', 'M18 7h4v4h-4V7Z'],
];
---
<svg class="benefit-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[index].map(d => <path d={d} />)}
</svg>
