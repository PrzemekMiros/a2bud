<dialog class="gallery-lightbox" aria-labelledby="lightbox-title">
  <div class="lightbox-shell">
    <header class="lightbox-header">
      <div><span class="lightbox-brand">A2BUD / GALERIA</span><h2 id="lightbox-title">Zdjęcie realizacji</h2></div>
      <button class="lightbox-close" type="button" aria-label="Zamknij galerię" autofocus>×</button>
    </header>
    <div class="lightbox-stage">
      <button class="lightbox-prev" type="button" aria-label="Poprzednie zdjęcie">←</button>
      <div class="lightbox-image-area" aria-busy="false">
        <img class="lightbox-image" alt="" decoding="async" />
        <span class="lightbox-loader" aria-hidden="true"></span>
        <p class="lightbox-error" hidden>Nie udało się wczytać zdjęcia. <a href="#" target="_blank" rel="noopener noreferrer">Otwórz oryginał ↗</a></p>
      </div>
      <button class="lightbox-next" type="button" aria-label="Następne zdjęcie">→</button>
    </div>
    <div class="lightbox-caption" aria-live="polite" aria-atomic="true"><p class="lightbox-description"></p><span class="lightbox-counter"></span></div>
    <div class="lightbox-thumbnails" role="group" aria-label="Wybierz zdjęcie"></div>
    <p class="lightbox-hint">← → Zmień zdjęcie <span>·</span> Esc Zamknij <span>·</span> Na telefonie przesuń zdjęcie</p>
  </div>
</dialog>

<script>
const dialog = document.querySelector<HTMLDialogElement>('.gallery-lightbox');
if (dialog) {
  const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
  const area = dialog.querySelector<HTMLElement>('.lightbox-image-area')!;
  const title = dialog.querySelector<HTMLElement>('#lightbox-title')!;
  const description = dialog.querySelector<HTMLElement>('.lightbox-description')!;
  const counter = dialog.querySelector<HTMLElement>('.lightbox-counter')!;
  const thumbnails = dialog.querySelector<HTMLElement>('.lightbox-thumbnails')!;
  const error = dialog.querySelector<HTMLElement>('.lightbox-error')!;
  const previous = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
  const next = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'));
  let photos: HTMLAnchorElement[] = [];
  let active = 0;
  let request = 0;
  let closing = false;
  let opener: HTMLAnchorElement | null = null;
  let previousOverflow = '';
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  async function show(index: number, direction = 1) {
    active = (index + photos.length) % photos.length;
    const ticket = ++request;
    const link = photos[active];
    const alt = link.querySelector('img')?.alt || link.dataset.title || 'Zdjęcie realizacji';
    title.textContent = link.dataset.title || 'Zdjęcie realizacji';
    description.textContent = alt;
    counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(photos.length).padStart(2, '0')}`;
    previous.disabled = next.disabled = photos.length < 2;
    error.hidden = true;
    error.querySelector('a')!.href = link.href;
    area.setAttribute('aria-busy', 'true');
    image.getAnimations().forEach(animation => animation.cancel());
    image.style.opacity = '0';
    const thumbButtons = thumbnails.querySelectorAll('button');
    thumbButtons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === active)));
    const selected = thumbButtons[active];
    if (selected) thumbnails.scrollTo({ left: selected.offsetLeft - thumbnails.offsetLeft - thumbnails.clientWidth / 2 + selected.clientWidth / 2, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    const preload = new Image();
    preload.src = link.href;
    try {
      await preload.decode();
      if (ticket !== request || !dialog!.open || closing) return;
      image.src = link.href;
      image.alt = alt;
      area.setAttribute('aria-busy', 'false');
      image.style.opacity = '1';
      if (!reducedMotion.matches) image.animate([
        { opacity: 0, transform: `translateX(${direction * 22}px) scale(.985)` },
        { opacity: 1, transform: 'translateX(0) scale(1)' }
      ], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' });
    } catch {
      if (ticket !== request || !dialog!.open || closing) return;
      area.setAttribute('aria-busy', 'false');
      error.hidden = false;
    }
  }

  function close() {
    if (!dialog!.open || closing) return;
    closing = true;
    request++;
    dialog!.classList.add('is-closing');
    closeTimer = setTimeout(() => dialog!.close(), reducedMotion.matches ? 0 : 180);
  }

  links.forEach(link => link.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (dialog.open) return;
    photos = links.filter(item => !item.closest<HTMLElement>('.project-card')?.hidden);
    opener = link;
    closing = false;
    dialog.classList.remove('is-closing');
    thumbnails.replaceChildren();
    photos.forEach((photo, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('aria-label', `Zdjęcie ${index + 1}: ${photo.querySelector('img')?.alt || photo.dataset.title}`);
      button.setAttribute('aria-pressed', 'false');
      const thumb = document.createElement('img');
      thumb.src = photo.href;
      thumb.alt = '';
      thumb.loading = 'lazy';
      thumb.decoding = 'async';
      button.append(thumb);
      button.addEventListener('click', () => { if (!closing) void show(index, index < active ? -1 : 1); });
      thumbnails.append(button);
    });
    previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
    void show(photos.indexOf(link));
  }));

  previous.addEventListener('click', () => { if (!closing) void show(active - 1, -1); });
  next.addEventListener('click', () => { if (!closing) void show(active + 1); });
  dialog.querySelector('.lightbox-close')!.addEventListener('click', close);
  dialog.addEventListener('cancel', event => { event.preventDefault(); close(); });
  dialog.addEventListener('click', event => { if (event.target === dialog) close(); });
  dialog.addEventListener('keydown', event => {
    if (closing || event.altKey || event.metaKey || event.ctrlKey) return;
    if (event.key === 'ArrowLeft') { event.preventDefault(); void show(active - 1, -1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); void show(active + 1); }
    if (event.key === 'Home') { event.preventDefault(); void show(0, -1); }
    if (event.key === 'End') { event.preventDefault(); void show(photos.length - 1); }
  });
  dialog.addEventListener('close', () => {
    clearTimeout(closeTimer);
    request++;
    closing = false;
    document.documentElement.style.overflow = previousOverflow;
    dialog.classList.remove('is-closing');
    image.removeAttribute('src');
    opener?.focus({ preventScroll: true });
  });

  let touchStart: { x: number; y: number } | null = null;
  area.addEventListener('touchstart', event => {
    touchStart = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
  }, { passive: true });
  area.addEventListener('touchcancel', () => { touchStart = null; });
  area.addEventListener('touchend', event => {
    if (!touchStart || closing) return;
    const dx = event.changedTouches[0].clientX - touchStart.x;
    const dy = event.changedTouches[0].clientY - touchStart.y;
    touchStart = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) void show(active + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  }, { passive: true });
}
</script>

<style>
dialog.gallery-lightbox { width:min(1240px,calc(100% - 48px)); max-width:1240px; max-height:calc(100dvh - 40px); padding:0; border:1px solid #ffffff20; border-radius:16px; background:#13171af5; color:white; box-shadow:0 30px 100px #0009; overflow:auto; overscroll-behavior:contain; }
.gallery-lightbox::backdrop { background:#080c12d9; backdrop-filter:blur(12px); }
.gallery-lightbox[open] { animation:lightbox-in .28s cubic-bezier(.2,.7,.2,1); }
.gallery-lightbox[open]::backdrop { animation:backdrop-in .28s ease-out; }
.gallery-lightbox.is-closing { animation:lightbox-out .18s ease-in forwards; }
.gallery-lightbox.is-closing::backdrop { animation:backdrop-out .18s ease-in forwards; }
.lightbox-shell { padding:22px 26px 16px; }
.lightbox-header { display:flex; align-items:center; justify-content:space-between; gap:24px; margin-bottom:16px; }
.lightbox-brand { font-size:9px; letter-spacing:2px; color:#72afff; }
.lightbox-header h2 { font-size:clamp(16px,2vw,23px); letter-spacing:-.025em; margin-top:7px; }
.gallery-lightbox button { background:#ffffff0b; border:1px solid #ffffff24; color:white; border-radius:50%; display:grid; place-items:center; flex-shrink:0; }
.gallery-lightbox button:hover { background:#0069f3; border-color:#0069f3; }
.lightbox-close { width:44px; height:44px; font-size:30px; line-height:1; }
.lightbox-stage { display:grid; grid-template-columns:44px minmax(0,1fr) 44px; align-items:center; gap:18px; }
.lightbox-prev,.lightbox-next { width:44px; height:44px; font-size:22px; }
.lightbox-prev:disabled,.lightbox-next:disabled { opacity:.3; }
.lightbox-image-area { height:clamp(160px,calc(100dvh - 300px),720px); position:relative; display:grid; place-items:center; min-width:0; }
.lightbox-image { width:100%; height:100%; object-fit:contain; min-height:0; border-radius:4px; user-select:none; }
.lightbox-loader { position:absolute; width:30px; height:30px; border:2px solid #ffffff25; border-top-color:#72afff; border-radius:50%; display:none; animation:lightbox-spin .7s linear infinite; }
[aria-busy=true] .lightbox-loader { display:block; }
.lightbox-error { position:absolute; padding:24px; text-align:center; color:#d5dbe0; font-size:13px; }
.lightbox-error a { display:block; color:#72afff; margin-top:10px; text-decoration:underline; }
.lightbox-caption { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:15px 62px; }
.lightbox-description { color:#c7ced5; font-size:12px; line-height:1.6; margin:0; }
.lightbox-counter { font-size:11px; color:#72afff; white-space:nowrap; font-variant-numeric:tabular-nums; }
.lightbox-thumbnails { display:flex; gap:9px; overflow-x:auto; padding:6px 2px 10px; margin:0 60px; scrollbar-width:thin; scrollbar-color:#46505b transparent; }
.lightbox-thumbnails :global(button) { width:64px; height:46px; padding:3px; border-radius:6px; opacity:.5; border:1px solid transparent; background:transparent; }
.lightbox-thumbnails :global(button[aria-pressed=true]) { opacity:1; border-color:#72afff; background:#0069f322; }
.lightbox-thumbnails :global(button:hover),.lightbox-thumbnails :global(button:focus-visible) { opacity:1; }
.lightbox-thumbnails :global(img) { width:100%; height:100%; object-fit:cover; border-radius:3px; }
.lightbox-hint { text-align:center; font-size:9px; color:#9da6af; margin:10px 0 0; }
.lightbox-hint span { margin:0 10px; color:#72afff; }
@keyframes lightbox-in { from { opacity:0; transform:translateY(20px) scale(.97); } to { opacity:1; transform:none; } }
@keyframes lightbox-out { to { opacity:0; transform:translateY(12px) scale(.98); } }
@keyframes backdrop-in { from { opacity:0; } to { opacity:1; } }
@keyframes backdrop-out { to { opacity:0; } }
@keyframes lightbox-spin { to { transform:rotate(360deg); } }
@media(max-width:600px) {
  dialog.gallery-lightbox { width:calc(100% - 16px); max-height:calc(100dvh - 16px); border-radius:12px; }
  .lightbox-shell { padding:16px 12px; }
  .lightbox-header { gap:12px; }
  .lightbox-header h2 { font-size:16px; }
  .lightbox-stage { position:relative; display:block; }
  .lightbox-image-area { height:clamp(180px,calc(100dvh - 300px),600px); }
  .lightbox-prev,.lightbox-next { position:absolute; top:50%; z-index:1; transform:translateY(-50%); background:#13171acc!important; }
  .lightbox-prev { left:3px; } .lightbox-next { right:3px; }
  .lightbox-caption { padding:14px 2px; gap:12px; }
  .lightbox-description { font-size:11px; }
  .lightbox-thumbnails { margin:0; }
  .lightbox-hint { font-size:8px; line-height:1.8; }
  .lightbox-hint span { margin:0 5px; }
}
@media(prefers-reduced-motion:reduce) {
  .gallery-lightbox,.gallery-lightbox::backdrop,.lightbox-loader { animation:none!important; }
}
</style>
