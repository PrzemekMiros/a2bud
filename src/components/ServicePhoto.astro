---
interface Props {
  image: {
    src: string;
    alt: string;
    width: number;
    height: number;
    position?: string;
  };
}

const { image } = Astro.props;
---

<div class="service-photo">
  <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading="lazy"
    decoding="async"
    style={{ objectPosition: image.position ?? '50% 50%' }}
  />
</div>

<style>
  .service-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e9ebeb;
    border: 1px solid var(--line);
  }

  .service-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.service-card) .service-photo {
    aspect-ratio: 1.9;
    border: 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 600px) {
    :global(.service-card) .service-photo {
      aspect-ratio: 1.85;
    }
  }
</style>
