---
import Layout from '../../layouts/Layout.astro';
import ServicePhoto from '../../components/ServicePhoto.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
export function getStaticPaths() { return services.map((service, i) => ({ params: { slug: service.slug }, props: { service, i } })); }
const { service, i } = Astro.props;
const related = [services[(i + 1) % services.length], services[(i + 2) % services.length]];
---
<Layout title={`${service.name} Warszawa | A2BUD`} description={`${service.description} A2BUD — Warszawa i okolice. Skontaktuj się z nami i omów zakres prac.`}><section class="page-intro container"><a class="eyebrow" href="/uslugi/">← WSZYSTKIE USŁUGI / {String(i + 1).padStart(2, '0')}</a><h1>{service.name}<span class="accent">.</span></h1><p>{service.description}</p></section><section class="section muted"><div class="container about-grid"><ServicePhoto image={service.image} /><div><p class="eyebrow">WARSZAWA I OKOLICE</p><h2>Zakres, który odpowiada<br/>Twoim potrzebom.</h2><p>{service.description}</p><h3>Zakres prac</h3><ul class="scope-list">{service.scope.map(item => <li>{item}</li>)}</ul><a class="button" href={`/kontakt/?usluga=${service.slug}`}>Zapytaj o wycenę <span>↗</span></a></div></div></section><section class="section container detail-bottom"><div><p class="eyebrow">KOMPLEKSOWA REALIZACJA</p><h2>Wszystko łączy się w całość.</h2><p>{service.benefit}</p><p>Zakres oraz dobór rozwiązań ustalamy indywidualnie, uwzględniając stan nieruchomości i planowany sposób użytkowania.</p></div><div><h2 class="small-heading">Powiązane usługi</h2>{related.map(item => <a class="related-link" href={`/uslugi/${item.slug}/`}>{item.name}<span>↗</span></a>)}</div></section><CTA/></Layout>
