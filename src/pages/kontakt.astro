---
import Layout from '../layouts/Layout.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { services } from '../data/services';
---
<Layout title="Kontakt i wycena remontu — A2BUD Warszawa" description="Porozmawiajmy o Twojej inwestycji. A2BUD, Warszawa i okolice. Telefon 792 698 858 lub 730 340 032. E-mail: biuro01.a2bud@gmail.com."><section class="page-intro container"><p class="eyebrow">A2BUD / KONTAKT</p><h1><span class="heading-first-line">Porozmawiajmy</span><br/>o Twojej inwestycji</h1><p>Masz pomysł, projekt lub pytanie? Zróbmy pierwszy krok.</p></section><section class="section muted"><div class="container contact-grid"><aside><p class="eyebrow">JESTEŚMY DO TWOJEJ DYSPOZYCJI</p><h2><span class="heading-first-line">Dobry początek?</span><br/>Rozmowa</h2><div class="contact-block"><h3>Zadzwoń</h3><a href="tel:+48792698858"><ContactIcon name="phone" /><span>792 698 858</span></a><a href="tel:+48730340032"><ContactIcon name="phone" /><span>730 340 032</span></a></div><div class="contact-block"><h3>Napisz</h3><a class="email-link" href="mailto:biuro01.a2bud@gmail.com"><ContactIcon name="mail" /><span>biuro01.a2bud@gmail.com</span></a></div><div class="contact-block"><h3>Obszar działania</h3><p>Warszawa i okolice</p></div></aside><form id="contact-form"><h2>Opowiedz nam o swoich planach</h2><div class="form-grid"><label>Imię i nazwisko *<input name="name" autocomplete="name" required maxlength="120" placeholder="Jan Kowalski"/></label><label>Telefon *<input name="phone" type="tel" autocomplete="tel" required pattern="[+0-9\s()\-]{7,25}" title="Podaj numer telefonu (7–25 znaków: cyfry, spacje, +, nawiasy lub myślniki)." placeholder="Twój numer telefonu"/></label><label>E-mail *<input name="email" type="email" autocomplete="email" required maxlength="160" placeholder="twoj@email.pl"/></label><label>Rodzaj usługi *<select name="service" id="service" required><option value="">Wybierz usługę</option>{services.map(service => <option value={service.slug}>{service.name}</option>)}<option value="inne">Kilka usług / inny zakres</option></select></label><label class="full">Lokalizacja inwestycji *<input name="location" required maxlength="180" placeholder="Miejscowość lub dzielnica"/></label><label class="full">Opis planowanych prac *<textarea name="description" required minlength="20" maxlength="2500" rows="5" placeholder="Opisz przestrzeń i planowany zakres prac (min. 20 znaków)."></textarea></label><label class="full file-label">Załączniki (opcjonalnie)<input id="attachments" type="file" multiple accept="image/*,.pdf" aria-describedby="attachment-help"/></label></div><p class="form-note">* Pola wymagane. Dane wpisane do formularza pozostają w przeglądarce do chwili przekazania ich do programu pocztowego. <a href="/polityka-prywatnosci/">Informacje o prywatności</a>.</p><button class="button" type="submit">Wyślij zapytanie <span>↗</span></button><p id="form-status" role="status" aria-live="polite"></p><noscript>Włącz JavaScript, aby przygotować wiadomość, lub napisz bezpośrednio na biuro01.a2bud@gmail.com.</noscript></form></div></section></Layout>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
const select = document.querySelector<HTMLSelectElement>('#service');
const selected = new URLSearchParams(window.location.search).get('usluga');
if(select && selected && Array.from(select.options).some(option => option.value === selected)) select.value = selected;
form?.addEventListener('submit', event => { event.preventDefault(); if(!form.reportValidity()) return; const data = new FormData(form); const files = document.querySelector<HTMLInputElement>('#attachments')?.files; const names = files ? Array.from(files).map(file => file.name).join(', ') : ''; const service = select?.selectedOptions[0]?.textContent || ''; const body = `Dzień dobry,\n\nProszę o kontakt w sprawie inwestycji.\n\nImię i nazwisko: ${data.get('name')}\nTelefon: ${data.get('phone')}\nE-mail: ${data.get('email')}\nUsługa: ${service}\nLokalizacja: ${data.get('location')}\n\nOpis prac:\n${data.get('description')}${names ? `\n\nPliki do dołączenia ręcznie: ${names}` : ''}`; window.location.href = `mailto:biuro01.a2bud@gmail.com?subject=${encodeURIComponent(`Zapytanie A2BUD — ${service}`)}&body=${encodeURIComponent(body)}`; const status = document.querySelector('#form-status'); if(status) status.textContent = 'Przygotowano wiadomość do otwarcia w programie pocztowym. Zapytanie nie zostało wysłane przez stronę. Sprawdź treść, dołącz wybrane pliki i wyślij e-mail. Jeśli program się nie otworzył, napisz bezpośrednio na biuro01.a2bud@gmail.com.'; });
</script>

<style>
.contact-block a { display:flex; align-items:center; gap:12px; }
.contact-block a span { min-width:0; overflow-wrap:anywhere; }
</style>
