---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import CTA from '../components/CTA.astro';
import { categories } from '../data/services';
---
<Layout title="Realizacje — galeria prac A2BUD | Warszawa" description="Miejsce na przyszłą galerię realizacji A2BUD: mieszkania, domy, łazienki, biura, posadzki i prace budowlane."><section class="page-intro container"><p class="eyebrow">A2BUD / REALIZACJE</p><h1>Przestrzenie.<br/>Materiały. Detale<span class="accent">.</span></h1><p>Przygotowujemy galerię naszych prac. Widoczne poniżej karty są miejscami na przyszłe realizacje, a nie prezentacją ukończonych projektów.</p></section><section class="section muted"><div class="container"><div class="filters" role="group" aria-label="Filtruj kategorie realizacji">{['Wszystkie', ...categories].map((name, i) => <button data-filter={i === 0 ? 'all' : name} aria-pressed={i === 0}>{name}</button>)}</div><p id="gallery-count" class="portfolio-note" aria-live="polite">5 miejsc na przyszłe realizacje</p><div class="project-grid">{categories.map((category, i) => <article class="project-card" data-category={category}><Placeholder label={`Zdjęcie realizacji 0${i + 1} — ${category}`}/><div class="project-body"><p class="eyebrow">{category}</p><h2>Nazwa realizacji — do uzupełnienia</h2><p class="project-location">Lokalizacja — do uzupełnienia</p><p>Miejsce na opis zakresu wykonanych prac, zastosowanych materiałów i rozwiązań.</p><details><summary>Dodatkowe zdjęcia <span>+</span></summary><div class="additional-photos"><Placeholder label={`Realizacja 0${i + 1} — przed pracami`}/><Placeholder label={`Realizacja 0${i + 1} — po pracach`}/></div></details></div></article>)}</div></div></section><CTA/></Layout>
<script>
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button => button.addEventListener('click', () => { let count = 0; buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button))); document.querySelectorAll<HTMLElement>('[data-category]').forEach(card => { card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter; if (!card.hidden) count++; }); const status = document.querySelector('#gallery-count'); if(status) status.textContent = count === 1 ? '1 miejsce na przyszłą realizację' : `${count} miejsc na przyszłe realizacje`; }));
</script>
