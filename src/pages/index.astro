---
import Layout from '../layouts/Layout.astro';

import ServiceGrid from '../components/ServiceGrid.astro';
import CTA from '../components/CTA.astro';
import BenefitIcon from '../components/BenefitIcon.astro';
import AudienceIcon from '../components/AudienceIcon.astro';
import ServicePhoto from '../components/ServicePhoto.astro';
import { projects } from '../data/projects';

const featuredProjects = ['Mieszkania i domy', 'Łazienki i kuchnie', 'Biura i lokale usługowe'].map(label => ({
  label,
  image: projects.find(project => project.categories.includes(label))!.images[0],
}));
---
<Layout title="A2BUD — firma budowlana Warszawa | Remonty i wykończenia" description="Kompleksowe usługi budowlane, remonty mieszkań i wykończenia wnętrz w Warszawie i okolicach. Poznaj A2BUD i zapytaj o wycenę inwestycji.">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> A2BUD · WARSZAWA I OKOLICE</p><h1>Budujemy<br/>Remontujemy<br/><span>Wykańczamy</span></h1><p class="hero-description">Kompleksowe usługi budowlane i wykończeniowe w Warszawie i okolicach. Od projektu i prac budowlanych po dopracowane w każdym detalu wnętrza.</p><div class="hero-actions"><a class="button" href="/kontakt/">Zapytaj o wycenę <span>↗</span></a><a class="secondary-link" href="/uslugi/">Poznaj nasze usługi <span>→</span></a></div><div class="hero-note"><span class="tiny-line"></span> JEDEN PARTNER. KOMPLEKSOWA REALIZACJA.</div></div><div class="hero-visual"><img class="hero-photo" src="/img/services/3/WhatsApp%20Image%202026-11-15%20at%2019.09.23%20(7).jpeg" alt="Jasny salon z jadalnią, dekoracyjnym sufitem i drewnianą podłogą" width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /><div class="visual-top"><span>OD KONCEPCJI DO REALIZACJI</span><span>01 / A2BUD</span></div><div class="visual-bottom"><span>Przestrzeń dla<br/><strong>Twoich planów.</strong></span></div><span class="vertical-note">BUDOWNICTWO / REMONTY / WYKOŃCZENIA</span></div></div></section>
<div class="audience-strip"><div class="container"><span>Twój projekt. Nasze możliwości.</span><span>Klienci indywidualni</span><i>+</i><span>Firmy</span><i>+</i><span>Deweloperzy</span><a href="#o-firmie" aria-label="Przejdź do informacji o firmie">↓</a></div></div>
<section class="section" id="o-firmie"><div class="container about-grid"><div class="about-visual"><ServicePhoto image={{ src: "/img/services/3/WhatsApp%20Image%202026-11-15%20at%2019.09.24.jpeg", alt: "Wykończony salon z jasnymi sofami, drewnianą podłogą i dekoracyjnym oświetleniem", width: 1600, height: 1066 }} /></div><div class="about-copy"><p class="eyebrow">01 / POZNAJ A2BUD</p><h2><span class="heading-first-line">Kompleksowe podejście</span><br/>do każdej inwestycji</h2><p>A2BUD świadczy szeroki zakres usług budowlanych, remontowych i wykończeniowych. Realizujemy prace w mieszkaniach, domach, biurach i lokalach usługowych.</p><p>Łączymy funkcjonalne rozwiązania z estetyką wykonania, dopasowując zakres prac do potrzeb i charakteru inwestycji.</p><a class="text-link" href="/o-nas/">Poznaj nas bliżej <span>↗</span></a></div></div></section>
<section class="section muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / ZAKRES NASZYCH PRAC</p><h2>Nasze usługi</h2></div><p>Od solidnych fundamentów po wykończenie wnętrza.<br/>Wybierz zakres dopasowany do Twoich planów.</p></div><ServiceGrid/></div></section>
<section class="section why-section"><div class="container why-grid"><div><p class="eyebrow">03 / DLACZEGO A2BUD</p><h2><span class="heading-first-line">Jedna firma</span><br/>Wiele możliwości</h2><p>Patrzymy na inwestycję jako całość.<br/>Ty wybierasz kierunek. My łączymy zakres prac.</p><a class="text-link" href="/kontakt/">Porozmawiajmy o Twoim projekcie <span>↗</span></a></div><div class="benefits">{['Kompleksowy zakres prac', 'Indywidualne podejście do inwestycji', 'Usługi dla klientów indywidualnych i biznesowych', 'Projektowanie połączone z wykonawstwem', 'Rozwiązania dopasowane do charakteru inwestycji'].map((text, i) => <div><BenefitIcon index={i} /><h3>{text}</h3><span class="benefit-number">0{i + 1}</span></div>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">04 / PRZESTRZENIE I DETALE</p><h2>Nasze realizacje</h2></div><a class="text-link" href="/realizacje/">Przejdź do galerii <span>↗</span></a></div><div class="portfolio-preview">{featuredProjects.map(({ label, image }) => <a class="project-preview" href="/realizacje/"><ServicePhoto image={image} /><div><h3>{label}</h3><span>↗</span></div></a>)}</div></div></section>
<section class="section audience-section"><div class="container"><p class="eyebrow">05 / DLA KOGO PRACUJEMY</p><h2><span class="heading-first-line">Różne potrzeby</span><br/>To samo zaangażowanie</h2><div class="audience-grid">{([['home', 'Klienci indywidualni', 'Remonty, modernizacje i wykończenia mieszkań oraz domów.'], ['office', 'Firmy', 'Adaptacje biur, lokali handlowych i powierzchni usługowych.'], ['buildings', 'Deweloperzy', 'Roboty budowlane oraz prace wykończeniowe związane z inwestycjami.']] as const).map(([icon, name, text]) => <article><AudienceIcon name={icon} /><h3>{name}</h3><p>{text}</p></article>)}</div></div></section><CTA/>
</Layout>

<style>
  .hero-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:58% 50%; }
  .hero-visual::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,rgba(19,23,26,.65) 0%,rgba(19,23,26,.08) 30%,rgba(19,23,26,.12) 55%,rgba(19,23,26,.82) 100%); pointer-events:none; }
  .hero-visual .visual-top,.hero-visual .visual-bottom { z-index:1; }
  .hero-visual .visual-top { color:#fff; }
  .hero-visual .visual-bottom strong { color:#e0e3e5; }
  .hero-visual .visual-arrow { background:#13171a66; border-color:#ffffff70; }
</style>