---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CTA from '../components/CTA.astro';
---
<Layout title="A2BUD — firma budowlana Warszawa | Remonty i wykończenia" description="Kompleksowe usługi budowlane, remonty mieszkań i wykończenia wnętrz w Warszawie i okolicach. Poznaj A2BUD i zapytaj o wycenę inwestycji.">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> A2BUD · WARSZAWA I OKOLICE</p><h1>Budujemy.<br/>Remontujemy.<br/><span>Wykańczamy.</span></h1><p class="hero-description">Kompleksowe usługi budowlane i wykończeniowe w Warszawie i okolicach. Od projektu i prac budowlanych po dopracowane w każdym detalu wnętrza.</p><div class="hero-actions"><a class="button" href="/kontakt/">Zapytaj o wycenę <span>↗</span></a><a class="secondary-link" href="/uslugi/">Poznaj nasze usługi <span>→</span></a></div><div class="hero-note"><span class="tiny-line"></span> JEDEN PARTNER. KOMPLEKSOWA REALIZACJA.</div></div><div class="hero-visual"><Placeholder dark label="Zdjęcie główne — nowoczesne wnętrze"/><div class="visual-top"><span>OD KONCEPCJI DO REALIZACJI</span><span>01 / A2BUD</span></div><div class="visual-bottom"><span>Przestrzeń dla<br/><strong>Twoich planów.</strong></span><span class="visual-arrow">↗</span></div><span class="vertical-note">BUDOWNICTWO / REMONTY / WYKOŃCZENIA</span></div></div></section>
<div class="audience-strip"><div class="container"><span>Twój projekt. Nasze możliwości.</span><span>Klienci indywidualni</span><i>+</i><span>Firmy</span><i>+</i><span>Deweloperzy</span><a href="#o-firmie" aria-label="Przejdź do informacji o firmie">↓</a></div></div>
<section class="section" id="o-firmie"><div class="container about-grid"><div class="about-visual"><Placeholder label="Zdjęcie — o firmie A2BUD"/><div class="visual-label"><span>A2BUD</span><span>Przemyślane rozwiązania.<br/>Dopracowane wykonanie.</span></div></div><div class="about-copy"><p class="eyebrow">01 / POZNAJ A2BUD</p><h2>Kompleksowe podejście<br/>do każdej inwestycji<span class="accent">.</span></h2><p>A2BUD świadczy szeroki zakres usług budowlanych, remontowych i wykończeniowych. Realizujemy prace w mieszkaniach, domach, biurach i lokalach usługowych.</p><p>Łączymy funkcjonalne rozwiązania z estetyką wykonania, dopasowując zakres prac do potrzeb i charakteru inwestycji.</p><a class="text-link" href="/o-nas/">Poznaj nas bliżej <span>↗</span></a></div></div></section>
<section class="section muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / ZAKRES NASZYCH PRAC</p><h2>Nasze usługi<span class="accent">.</span></h2></div><p>Od solidnych fundamentów po wykończenie wnętrza.<br/>Wybierz zakres dopasowany do Twoich planów.</p></div><ServiceGrid/></div></section>
<section class="section why-section"><div class="container why-grid"><div><p class="eyebrow">03 / DLACZEGO A2BUD</p><h2>Jedna firma.<br/>Wiele możliwości<span class="accent">.</span></h2><p>Patrzymy na inwestycję jako całość.<br/>Ty wybierasz kierunek. My łączymy zakres prac.</p><a class="text-link" href="/kontakt/">Porozmawiajmy o Twoim projekcie <span>↗</span></a></div><div class="benefits">{['Kompleksowy zakres prac', 'Indywidualne podejście do inwestycji', 'Usługi dla klientów indywidualnych i biznesowych', 'Projektowanie połączone z wykonawstwem', 'Rozwiązania dopasowane do charakteru inwestycji'].map((text, i) => <div><span class="benefit-icon" aria-hidden="true">{['⊞', '◇', '⌂', '⌑', '↗'][i]}</span><h3>{text}</h3><span class="benefit-number">0{i + 1}</span></div>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">04 / PRZESTRZENIE I DETALE</p><h2>Nasze realizacje<span class="accent">.</span></h2></div><a class="text-link" href="/realizacje/">Przejdź do galerii <span>↗</span></a></div><p class="portfolio-note">Przygotowujemy galerię naszych prac. Poniżej miejsca na przyszłe zdjęcia realizacji.</p><div class="portfolio-preview">{['Mieszkania i domy', 'Łazienki i kuchnie', 'Biura i lokale usługowe'].map((label, i) => <a class="project-preview" href="/realizacje/"><Placeholder label={`Zdjęcie realizacji 0${i + 1} — ${label}`}/><div><h3>{label}</h3><span>↗</span></div></a>)}</div></div></section>
<section class="section audience-section"><div class="container"><p class="eyebrow">05 / DLA KOGO PRACUJEMY</p><h2>Różne potrzeby.<br/>To samo zaangażowanie<span class="accent">.</span></h2><div class="audience-grid">{[['⌂', 'Klienci indywidualni', 'Remonty, modernizacje i wykończenia mieszkań oraz domów.'], ['▦', 'Firmy', 'Adaptacje biur, lokali handlowych i powierzchni usługowych.'], ['⊞', 'Deweloperzy', 'Roboty budowlane oraz prace wykończeniowe związane z inwestycjami.']].map(([icon, name, text]) => <article><span class="audience-icon" aria-hidden="true">{icon}</span><h3>{name}</h3><p>{text}</p></article>)}</div></div></section><CTA/>
</Layout>
