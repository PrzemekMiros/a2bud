---
import '../styles/global.css';
import ContactIcon from '../components/ContactIcon.astro';
import ConsentInit from '../components/ConsentInit.astro';
import CookieConsent from '../components/CookieConsent.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const nav = [['/', 'Strona główna'], ['/o-nas/', 'O nas'], ['/nasz-zespol/', 'Nasz zespół'], ['/uslugi/', 'Usługi'], ['/realizacje/', 'Realizacje'], ['/kontakt/', 'Kontakt']];
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://a2bud.pl');
---
<!doctype html><html lang="pl"><head><ConsentInit/><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#13171A"/><meta name="robots" content="index, follow, max-image-preview:large"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="pl_PL"/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="alternate" type="text/markdown" href="/llms.txt" title="A2BUD dla modeli językowych"/><link rel="sitemap" type="application/xml" href="/sitemap.xml"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body>
<a class="skip-link" href="#main">Przejdź do treści</a><header class="site-header"><div class="container header-inner"><a href="/" class="brand" aria-label="A2BUD — strona główna"><img src="/img/logo/logo.png" alt="A2BUD" width="1157" height="230" decoding="async" /></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Otwórz menu"><span></span><span></span></button><nav id="navigation" aria-label="Menu główne">{nav.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav><a class="button header-cta" href="/kontakt/">Zapytaj o wycenę <span>↗</span></a></div></header><main id="main"><slot/></main>
<footer><div class="container"><div class="footer-grid"><div><a href="/" class="brand footer-brand" aria-label="A2BUD — strona główna"><img src="/img/logo/logo-light.png" alt="A2BUD" width="364" height="72" loading="lazy" decoding="async" /></a><p>Od pierwszej koncepcji<br/>do dopracowanej przestrzeni.</p><span class="location">↗ Warszawa i okolice</span></div><div><h2>Na skróty</h2>{nav.slice(1).map(([href, label]) => <a href={href}>{label}</a>)}</div><div><h2>Porozmawiajmy</h2><a class="footer-contact" href="tel:+48792698858"><ContactIcon name="phone" /><span>792 698 858</span></a><a class="footer-contact" href="tel:+48730340032"><ContactIcon name="phone" /><span>730 340 032</span></a><a class="footer-contact" href="mailto:biuro01.a2bud@gmail.com"><ContactIcon name="mail" /><span>biuro01.a2bud@gmail.com</span></a></div><div><h2>Zbudujmy coś razem</h2><p>Masz pomysł na swoją przestrzeń?<br/>Porozmawiajmy o możliwościach.</p></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} A2BUD. Wszelkie prawa zastrzeżone.</span><div><a href="/polityka-prywatnosci/">Polityka prywatności</a><button data-cookie-open>Ustawienia cookies</button></div></div></div></footer>
<CookieConsent/>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu'); document.querySelector('#navigation')?.classList.toggle('is-open', open); });
document.addEventListener('keydown', (event) => { if(event.key === 'Escape') { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Otwórz menu'); document.querySelector('#navigation')?.classList.remove('is-open'); } });
</script></body></html>

<style>
.footer-grid>div>a.footer-contact { display:flex; align-items:center; gap:9px; }
.footer-contact span { min-width:0; overflow-wrap:anywhere; }
.footer-contact :global(svg) { width:18px; height:18px; color:#72afff; }
</style>
